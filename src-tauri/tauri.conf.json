{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ensayo",
  "version": "0.1.4",
  "identifier": "com.craftconceptsdigital.ensayo",
  "build": {
    "beforeDevCommand": "sh scripts/build-llm-helper.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/build-llm-helper.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Ensayo", "width": 1200, "height": 780, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }
    ],
    "security": { "csp": null },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ensayo-llm"],
    "windows": { "nsis": { "installerHooks": "windows/hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQTdCQTJFNzQ5MDM1NDIKUldSQ05aQjBMcnFudlF0NVJWVDMwN1dVUDJ3SVVpMnkrK3hBRXByYWlBWk5rOGxRWWtzdlZaNDkK",
      "endpoints": ["https://github.com/mmnzns/ensayo/releases/latest/download/latest.json"]
    }
  }
}
